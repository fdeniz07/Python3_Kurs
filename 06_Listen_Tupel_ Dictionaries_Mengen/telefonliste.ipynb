import sys

# Das Telefonbuch als Dictionary (Name: Telefonnummer)
TELEFONBUCH = {
    "Mathias": "0201 461487",
    "Marius": "0177 3543488",
    "Bea": "0201 334100",
}

while True:
    # Hauptmenü anzeigen
    print("\n(T)elefonnummer suchen")
    print("(N)ame suchen")
    print("(E)nde")
    
    # Benutzereingabe für die Auswahl
    auswahl = input("Auswahl (t, n, e): ").strip().lower()
    
    if auswahl == 't':
        # Nach Telefonnummer suchen (Suche nach Namen)
        suchwort = input("Suchwort: ").strip()
        
        # Durch das Telefonbuch iterieren
        for name, nummer in TELEFONBUCH.items():
            # Überprüfung, ob das Suchwort im Namen enthalten ist (Groß-/Kleinschreibung ignorieren)
            if suchwort.lower() in name.lower():
                print(f"{name} {nummer}")
                
    elif auswahl == 'n':
        # Nach Name suchen (Suche nach Ziffern/Nummer)
        ziffern = input("Ziffern: ").strip()
        
        # Durch das Telefonbuch iterieren
        for name, nummer in TELEFONBUCH.items():
            # Leerzeichen in der Telefonnummer entfernen für eine flexiblere Suche
            formatierte_nummer = nummer.replace(" ", "")
            
            # Überprüfung, ob die Ziffern in der Nummer existieren
            if ziffern in formatierte_nummer or ziffern in nummer:
                print(f"{name} {nummer}")
                
    elif auswahl == 'e':
        # Programm beenden
        print("Programm wird beendet. Auf Wiedersehen!")
        sys.exit()